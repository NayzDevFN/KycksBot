# ===================== KYCKS BOT CONFIG =====================
# Variables d'environnement
# Ne mets JAMAIS le token dans le code, utilise le fichier .env

# Token du bot Discord (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=ton_token_ici

# Client ID du bot (Discord Developer Portal > General Information)
CLIENT_ID=ton_client_id_ici


# ID du serveur Discord (optionnel - pour commands slash en dev rapide)
# Si laissé vide, les commands seront enregistrées globalement (plus lent)
GUILD_ID=ton_serveur_id_ici

# Port du serveur web
PORT=3000

# ===================== LIENS =====================
# Lien d'invitation du bot
INVITE_LINK=https://discord.com/oauth2/authorize?client_id=ton_client_id_ici&scope=bot%20applications.commands&permissions=8

# Lien du Discord Developer Portal
DEV_PORTAL=https://discord.com/developers/applications
