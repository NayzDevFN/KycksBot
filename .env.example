# ===================== KYCKS BOT - ACLCLOUDS =====================
# Variables d'environnement pour ACLClouds
# Configure ces variables dans le panel ACLClouds (Startup > Environment Variables)
# Ne mets JAMAIS le token dans le code, utilise les variables privees du panel

# Token du bot Discord (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=ton_token_ici

# Client ID du bot (Discord Developer Portal > General Information)
CLIENT_ID=1544851212187340881

# ID du serveur Discord (optionnel - pour commands slash en dev rapide)
# Si laissé vide, les commands seront enregistrées globalement (plus lent)
GUILD_ID=ton_serveur_id_ici

# Port du serveur web (ACLClouds fournit automatiquement la variable PORT)
# Ne pas modifier si tu héberges sur ACLClouds
PORT=3000

# ===================== LIENS =====================
INVITE_LINK=https://discord.com/oauth2/authorize?client_id=1544851212187340881&scope=bot&permissions=8
